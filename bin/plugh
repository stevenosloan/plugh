#!/bin/sh
# plugh-shim
# plugh, as the plugin ships it: finds the real plugh and runs it. Claude Code
# puts this folder on the Bash tool's PATH while the plugin is enabled, so the
# skills and hooks can always run `plugh` whatever the project has.
#
# It tries, in order:
#   1. the project's Go tool, from go get -tool, so a project's pin wins
#   2. another plugh on PATH, e.g. from go install
#   3. go run at the version voice.yaml pins (plugh: vX.Y.Z), or latest
#
# Line 2 marks this file as a shim. Step 2 skips any plugh that has it, so
# two copies of the shim on PATH (say, the plugin loaded twice) can't run
# each other forever.
#
# Builtins only, so it works whatever else is on PATH.

module=github.com/stevenosloan/plugh/cmd/plugh

has_go=
command -v go >/dev/null 2>&1 && has_go=1

# 1. The project's Go tool. -n prints the command without running it.
if [ -n "$has_go" ] && go tool -n plugh >/dev/null 2>&1; then
	exec go tool plugh "$@"
fi

# is_shim says whether the file $1 is a copy of this script.
is_shim() {
	l1= l2=
	{ IFS= read -r l1; IFS= read -r l2; } <"$1" 2>/dev/null
	[ "$l2" = "# plugh-shim" ]
}

# 2. Another plugh on PATH. An empty entry means the current folder, which
# isn't somewhere to pick up a binary from, so skip it.
set -f
IFS=:
for d in $PATH; do
	if [ -n "$d" ] && [ -f "$d/plugh" ] && [ -x "$d/plugh" ] && ! is_shim "$d/plugh"; then
		unset IFS
		set +f
		exec "$d/plugh" "$@"
	fi
done
unset IFS
set +f

if [ -z "$has_go" ]; then
	echo "plugh: not installed, and there's no Go to run it with; see https://$module" >&2
	exit 127
fi

# 3. go run at the pinned version, from the nearest voice.yaml above here.
version=
cr=$(printf '\r')
dir=$PWD
while :; do
	if [ -f "$dir/voice.yaml" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			line=${line%"$cr"} # Windows line endings
			case $line in
			plugh:*)
				v=${line#plugh:}
				v=${v%%#*}         # trailing comment
				v=$(echo $v)       # surrounding space (echo is a builtin)
				v=${v#[\"\']} v=${v%[\"\']}
				[ -n "$v" ] && version=$v
				break
				;;
			esac
		done <"$dir/voice.yaml"
		break
	fi
	[ -z "$dir" ] || [ "$dir" = / ] && break
	dir=${dir%/*}
done

if [ -z "$version" ]; then
	version=latest
	echo "plugh: running the latest release with go run, which looks it up on every call; go install it, or pin a version in voice.yaml (plugh: vX.Y.Z)" >&2
fi

exec go run "$module@$version" "$@"
